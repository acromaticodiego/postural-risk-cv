.venv/
__pycache__/
*.pyc
.pytest_cache/

# Los datasets no van al repositorio. Su procedencia está en data/README.md.
data/raw/
data/keypoints/

# El material de afinado del detector de carga: vídeos propios, fotogramas, máscaras,
# la hoja de contactos de revisión y el dataset que se arma para entrenar. Son
# imágenes de personas y no entran al repositorio bajo ningún concepto. Se regeneran
# con scripts/extract_load_frames.py y scripts/prelabel_sam.py.
data/carga/
data/carga_ensayo/

# Pesos de modelos: los de ultralytics se descargan solos, los entrenados son
# artefactos de una corrida concreta y se citan por su registro, no por el repo.
*.pt
*.onnx
*.engine

# Nada de imágenes de personas en el repositorio. La garantía de privacidad
# del sistema sería una broma si el repo llevara fotogramas dentro.
*.mp4
*.avi
*.mkv
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg

# La demo del panel: datos generados, no van al repositorio.
artifacts/demo/

# El modelo entrenado es un artefacto de una corrida, no codigo.
artifacts/modelo/

# Los pesos entrenados son artefactos de una corrida, no codigo.
artifacts/modelo/
